/* todo - Textual CSS スタイル

   色は端末のANSIパレット (ユーザーのターミナル配色設定) に追従させる。
   テーマ自体も ansi-dark を使っているため、ここで指定するのは
   パネルの区切りとレイアウトが中心。 */

Screen {
    background: ansi_default;
    layout: vertical;
}

#main {
    height: 1fr;
    margin: 0 1;
}

/* ── 左: TODOリスト ───────────── */
#task-panel {
    width: 1fr;
    min-width: 32;
    border: round ansi_bright_black;
    border-title-color: ansi_white;
    border-title-style: bold;
}

/* 未完了・完了のタブと、切り替えキーの案内を1行に並べる
   (タブは見出しと下線で2行使うので、案内は上の行に揃える) */
#task-tabs-row {
    height: 2;
    margin: 0 1;
}

/* Tabs は中身に合わせて縮まないので、2つのタブが収まる幅を与えて
   案内をその右隣に置く (全幅のままだと案内が端末の右端まで離れてしまう) */
#task-tabs {
    width: 16;
}

#tab-hint {
    width: 1fr;
    height: 1;
    color: ansi_bright_black;
}

/* 操作対象のパネルが分かるように、フォーカス中は枠の色を変える */
#task-panel:focus-within,
#calendar-panel:focus-within {
    border: round ansi_blue;
}

#task-table {
    height: 1fr;
}

/* 一覧の下の詳細欄 (1行目に概要、その下にメモ。
   メモが入りきらない分は m キーの全画面で読む) */
#memo-pane {
    dock: bottom;
    height: 6;
    padding: 0 1;
    border-top: solid ansi_bright_black;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
    overflow: hidden;
}

/* 概要は必ず1行に収める (メモに残す行数を一定にするため) */
#task-meta {
    height: 1;
}

/* ── 右: カレンダー + 内訳 ────── */
#side-panel {
    width: 31;
}

#calendar-panel {
    height: 10;
    padding: 0 1;
    border: round ansi_bright_black;
    border-title-color: ansi_white;
    border-title-style: bold;
}

/* 四半期 (年度と期間 / 進捗バー / 終了までの日数 の3行。設定でオンのときだけ出す) */
#quarter-panel {
    height: 5;
    padding: 0 1;
    border: round ansi_bright_black;
    border-title-color: ansi_white;
    border-title-style: bold;
}

#summary-panel {
    height: 1fr;
    min-height: 6;
    padding: 0 1;
    border: round ansi_bright_black;
    border-title-color: ansi_white;
    border-title-style: bold;
}

/* ── モーダルのボタン ───────────── */
/* 背景を塗らないので、枠でボタンの範囲を示す。
   配色はパネルと揃える (通常は灰、フォーカス中は青) */
#edit-buttons Button,
#confirm-buttons Button,
#settings-buttons Button,
#item-buttons Button,
#filter-buttons Button,
#link-buttons Button {
    border: round ansi_bright_black;
}

#edit-buttons Button:focus,
#confirm-buttons Button:focus,
#settings-buttons Button:focus,
#item-buttons Button:focus,
#filter-buttons Button:focus,
#link-buttons Button:focus {
    border: round ansi_blue;
}

/* 削除は危険な操作なので枠は常に赤のまま
   (フォーカスは Textual 側の反転表示で分かる) */
#confirm-buttons #delete,
#confirm-buttons #delete:focus {
    border: round ansi_red;
}

/* ── 追加・編集モーダル ────────── */
/* モーダルの背景は塗らず、後ろの画面を見えたままにする
   (裏の画面は Textual 側で dim になるので前後の区別はつく) */
TaskEditScreen {
    align: center middle;
    background: transparent;
}

#edit-dialog {
    width: 62;
    max-width: 90%;
    height: auto;
    /* 端末が低いときは項目が入りきらないのでスクロールさせる */
    max-height: 100%;
    overflow-y: auto;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
}

#edit-dialog Label {
    margin-top: 1;
    color: ansi_bright_black;
}

#edit-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#edit-buttons Button {
    margin-left: 2;
}

/* 入力欄とプルダウンは枠を省いて高さを詰めている (端末が低くてもフォームが
   収まるように)。代わりに背景で入力欄の範囲を示す */
#edit-dialog Input, #item-dialog Input, #link-dialog Input, #subtasks-dialog Input,
#edit-dialog Select > SelectCurrent, #item-dialog Select > SelectCurrent,
#settings-quarter Select > SelectCurrent {
    background: ansi_bright_black;
}

/* Select は枠線でしかフォーカスを示さない作りなので、枠を消すと変化が無くなる。
   開いたときの選択行と同じ配色 (block-cursor) で塗って分かるようにする。
   Input は Textual 側にフォーカス時の配色があるのでそれに任せる */
#edit-dialog Select:focus > SelectCurrent, #item-dialog Select:focus > SelectCurrent,
#settings-quarter Select:focus > SelectCurrent {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
}

/* SelectCurrent の中身は自前の色を持っているので、フォーカス時はまとめて上書きする */
#edit-dialog Select:focus > SelectCurrent Static#label,
#item-dialog Select:focus > SelectCurrent Static#label,
#settings-quarter Select:focus > SelectCurrent Static#label,
#edit-dialog Select:focus > SelectCurrent .arrow,
#item-dialog Select:focus > SelectCurrent .arrow,
#settings-quarter Select:focus > SelectCurrent .arrow {
    color: $block-cursor-foreground;
}

/* 優先度とステータスは横に並べる */
#edit-selects {
    height: auto;
}

#edit-selects > Vertical {
    width: 1fr;
    height: auto;
}

#edit-selects > Vertical:last-of-type {
    margin-left: 2;
}

#tags {
    height: auto;
    max-height: 6;
    border: none;
    background: ansi_black;
}

#no-tags {
    color: ansi_bright_black;
}

/* フォームのメモ欄は控えだけ (本文の編集は全画面) */
#memo-row {
    height: 1;
}

#memo-preview {
    width: 1fr;
    height: 1;
}

/* フォームのリンク欄も控えだけ (追加・編集は別画面) */
#links-row {
    height: 1;
}

#links-preview {
    width: 1fr;
    height: 1;
}

/* フォームのチェックリスト欄も控えだけ (追加・完了は別画面) */
#subtasks-row {
    height: 1;
}

#subtasks-preview {
    width: 1fr;
    height: 1;
}

/* ── 絞り込みモーダル ────────────── */
FilterScreen {
    align: center middle;
    background: transparent;
}

#filter-dialog {
    width: 52;
    max-width: 90%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
}

#filter-dialog Label {
    margin-top: 1;
    color: ansi_bright_black;
}

/* 項目が多いときは縦にスクロールさせる */
#filter-statuses, #filter-tags {
    height: auto;
    max-height: 8;
    border: none;
    background: ansi_black;
}

#filter-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#filter-buttons Button {
    margin-left: 2;
}

/* ── メモの全画面表示・編集 ────────── */
MemoViewScreen, MemoEditScreen {
    background: ansi_default;
}

#memo-dialog {
    width: 100%;
    height: 100%;
    padding: 0 1;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
}

#memo-header {
    height: auto;
    padding: 0 1;
    background: ansi_bright_black;
}

#memo-body {
    height: 1fr;
    padding: 1;
    scrollbar-size-vertical: 1;
}

#memo-editor {
    height: 1fr;
    margin-top: 1;
    border: none;
}

/* メモ本文の markdown 表示。
   端末のANSIパレットに合わせ、見出し・強調・表の枠だけを色で付ける
   (Textual 既定の背景付き見出しは端末の配色から浮くため上書きする)。 */
#memo-text {
    padding: 0;
}

/* メモが無いときの案内文 */
#memo-text.empty {
    color: ansi_bright_black;
}

#memo-text MarkdownH1,
#memo-text MarkdownH2,
#memo-text MarkdownH3,
#memo-text MarkdownH4,
#memo-text MarkdownH5,
#memo-text MarkdownH6 {
    background: ansi_default;
    text-style: bold;
    content-align: left middle;
    width: 1fr;
    margin: 1 0 0 0;
    padding: 0;
}

#memo-text MarkdownH1 {
    color: ansi_bright_blue;
}

#memo-text MarkdownH2 {
    color: ansi_bright_cyan;
}

#memo-text MarkdownH3,
#memo-text MarkdownH4,
#memo-text MarkdownH5,
#memo-text MarkdownH6 {
    color: ansi_cyan;
}

/* 太字・斜体・インラインコードは色で見分ける (端末が斜体を描けないため) */
#memo-text MarkdownBlock > .strong {
    color: ansi_yellow;
    text-style: bold;
}

#memo-text MarkdownBlock > .em {
    color: ansi_bright_white;
    text-style: italic;
}

#memo-text MarkdownBlock > .code_inline {
    color: ansi_magenta;
}

#memo-text MarkdownBullet {
    color: ansi_blue;
}

#memo-text MarkdownBlockQuote {
    background: ansi_default;
    border-left: outer ansi_bright_black;
    margin: 0 0 1 0;
}

#memo-text MarkdownFence {
    border-left: outer ansi_bright_black;
    margin: 0 0 1 0;
    padding: 0 1;
}

#memo-text MarkdownHorizontalRule {
    border-bottom: solid ansi_bright_black;
}

/* 表は罫線 (keyline) で枠を描く */
#memo-text MarkdownTableContent {
    keyline: thin ansi_bright_black;
}

#memo-text MarkdownTableContent > .header {
    color: ansi_blue;
}

/* ── リンクの一覧・編集 ─────────── */
LinksScreen, LinkEditScreen {
    align: center middle;
    background: transparent;
}

#links-dialog {
    width: 76;
    max-width: 96%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
}

/* 1件が2行 (タイトル + URL) なので、多いときは縦にスクロールさせる。
   端末が狭いときに横スクロールバーで1行取られないよう、横は切って出す */
#links-table {
    height: auto;
    max-height: 14;
    background: ansi_black;
    overflow-x: hidden;
}

#links-hint {
    height: auto;
    margin-top: 1;
    color: ansi_bright_black;
}

/* リンク1件の編集 */
#link-dialog {
    width: 62;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
}

#link-dialog Label {
    margin-top: 1;
    color: ansi_bright_black;
}

#link-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#link-buttons Button {
    margin-left: 2;
}

/* ── チェックリストの一覧・編集 ───── */
SubtasksScreen {
    align: center middle;
    background: transparent;
}

#subtasks-dialog {
    width: 62;
    max-width: 90%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
}

#subtasks-progress {
    height: 1;
    margin-bottom: 1;
}

/* 1件1行。多いときは縦にスクロールさせる (横は切って出し、横スクロールバーで
   1行取られないようにする) */
#subtasks-table {
    height: auto;
    max-height: 12;
    background: ansi_black;
    overflow-x: hidden;
}

#subtasks-input {
    margin-top: 1;
}

#subtasks-hint {
    height: auto;
    margin-top: 1;
    color: ansi_bright_black;
}

/* ── ステータスの選択 ───────────── */
StatusScreen {
    align: center middle;
    background: transparent;
}

#status-dialog {
    width: 42;
    max-width: 90%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
}

/* どのタスクのステータスを変えるのかを1行で示す */
#status-task {
    height: 1;
    margin-bottom: 1;
}

/* ステータスが多いときは縦にスクロールさせる */
#status-list {
    height: auto;
    max-height: 10;
    border: none;
    background: ansi_black;
}

/* ── 削除の確認 ─────────────────── */
ConfirmDeleteScreen {
    align: center middle;
    background: transparent;
}

#confirm-dialog {
    width: 52;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round ansi_red;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
}

#confirm-message {
    height: auto;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#confirm-buttons Button {
    margin-left: 2;
}

/* ── このアプリについて ─────────── */
AboutScreen {
    align: center middle;
    background: transparent;
}

#about-dialog {
    width: 52;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
}

#about-body {
    height: auto;
}

/* ── 設定画面 ───────────────────── */
SettingsScreen, ItemEditScreen {
    align: center middle;
    background: transparent;
}

#settings-dialog {
    width: 76;
    max-width: 96%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
}

#settings-lists {
    height: 12;
}

#status-panel {
    /* 名前・色・完了・使用の4列がちょうど収まる幅 */
    width: 36;
    height: 100%;
    border: round ansi_bright_black;
    border-title-color: ansi_white;
    border-title-style: bold;
}

#tag-panel {
    width: 1fr;
    height: 100%;
    margin-left: 1;
    border: round ansi_bright_black;
    border-title-color: ansi_white;
    border-title-style: bold;
}

#status-panel:focus-within, #tag-panel:focus-within {
    border: round ansi_blue;
}

#status-table, #tag-table {
    height: 1fr;
    background: ansi_black;
}

/* 四半期の表示切替と年度の開始月 (チェックボックスと選択欄を1行に並べる) */
#settings-quarter {
    height: auto;
    margin-top: 1;
}

#settings-quarter Checkbox {
    width: auto;
}

#settings-quarter Label {
    width: auto;
    margin: 0 1 0 3;
    color: ansi_bright_black;
}

#settings-quarter Select {
    /* 「12月 ▼」がちょうど収まる幅 */
    width: 8;
}

#settings-hint, #settings-note {
    height: auto;
    margin-top: 1;
    color: ansi_bright_black;
}

#settings-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#settings-buttons Button {
    margin-left: 2;
}

/* ステータス・タグ1件の編集 */
#item-dialog {
    width: 52;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round ansi_blue;
    border-title-color: ansi_white;
    border-title-style: bold;
}

#item-dialog Label {
    margin-top: 1;
    color: ansi_bright_black;
}

#item-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#item-buttons Button {
    margin-left: 2;
}
